  "scripts": {
    "build": "tsdown",
    "format": "prettier --write --log-level warn \"**/*.{ts,tsx,js,cjs,mjs,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,md}\"",
    "lint": "oxlint --type-aware --quiet",
    "lint:all": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run depcruise && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "e2e": "playwright test",
    "depcruise": "depcruise . --config .dependency-cruiser.cjs --ignore-known --output-type err-long",
    "depcruise:baseline": "depcruise-baseline . --config .dependency-cruiser.cjs"
  },

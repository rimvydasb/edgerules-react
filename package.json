        "default": "./dist/components/boxed-editor/index.js"
      },
      "require": {
        "types": "./dist/components/boxed-editor/index.d.cts",
        "default": "./dist/components/boxed-editor/index.cjs"
      }
    },
    "./test-cases-service": {
      "import": {
        "types": "./dist/components/test-cases-service/index.d.ts",
        "default": "./dist/components/test-cases-service/index.js"
      },
      "require": {
        "types": "./dist/components/test-cases-service/index.d.cts",
        "default": "./dist/components/test-cases-service/index.cjs"

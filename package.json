      "import": {
        "types": "./dist/components/documentation-service/index.d.ts",
        "default": "./dist/components/documentation-service/index.js"
      },
      "require": {
        "types": "./dist/components/documentation-service/index.d.cts",
        "default": "./dist/components/documentation-service/index.cjs"
      }
    },
    "./tests-manager": {
      "import": {
        "types": "./dist/components/tests-manager/index.d.ts",
        "default": "./dist/components/tests-manager/index.js"
      },
      "require": {
        "types": "./dist/components/tests-manager/index.d.cts",
        "default": "./dist/components/tests-manager/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "format": "prettier --write \"src/**/*.tsx\" \"stories/**/*.tsx\"",
    "format:check": "prettier --check \"src/**/*.tsx\" \"stories/**/*.tsx\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "e2e": "playwright test"
  },
  "peerDependencies": {

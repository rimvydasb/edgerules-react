{
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": false,
  "proseWrap": "always",
  "overrides": [
    {
      "files": ["*.js", "*.ts", "*.jsx", "*.tsx", "*.java", "*.rs"],
      "options": {
        "tabWidth": 4
      }
    }
  ]
}
